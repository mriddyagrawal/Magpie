# Which LLM provider to use. Valid: moonshot | openrouter | local
# (Provider-specific keys below; only the active provider's key needs to be set.)
LLM_PROVIDER=moonshot

# --- Moonshot Kimi (used when LLM_PROVIDER=moonshot) ---
MOONSHOT_API_KEY=sk-your-key-here
MOONSHOT_MODEL=kimi-k2.5
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# --- OpenRouter (used when LLM_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Local llama-cpp-python (cross-platform; LLM_PROVIDER=local) ---
# In-process inference via llama-cpp-python + GGUF weights. Cross-platform:
# Metal on macOS, CUDA on Linux/Win-CUDA, CPU fallback. After installing
# project deps, run `just install-llama` once to rebuild llama-cpp-python
# with the right hardware-acceleration flag — without that you'll get a
# CPU-only build that works but is much slower. See Plans/Local LLM Plan.md.
#
# `LOCAL_MODEL` is the HF GGUF *repo*; `LOCAL_QUANT` selects the specific
# file inside the repo. Defaults below pull Unsloth's Dynamic-2.0 Q5_K_XL
# quant of Gemma 4 E4B (~6.7 GB, balanced quality/speed). Smaller options:
# Q4_K_XL (~5.1 GB, faster). Higher quality: Q6_K_XL (~7.5 GB), Q8_K_XL (~8.7 GB).
LOCAL_MODEL=unsloth/gemma-4-E4B-it-GGUF
LOCAL_QUANT=Q5_K_XL
# Context window in tokens. Bigger = more KV-cache RAM. 8192 fits Magpie's
# T3 / answer prompts comfortably; raise if your answer step needs longer
# document slices.
LOCAL_N_CTX=8192
# How many layers to offload to GPU. -1 = all (recommended on Metal/CUDA),
# 0 = pure CPU. Set lower if VRAM is tight (e.g. 20 keeps the early layers
# on GPU but spills tail layers to CPU).
LOCAL_N_GPU_LAYERS=-1
# Sampling temperature. 0.0 = deterministic (good for structured-output
# T3 / rewrite). 0.7 = default for the answer step. /generate callers
# can override per-request.
LOCAL_TEMPERATURE=0.7

# --- Pipeline knobs ---
# Default for the /query endpoint's `rewrite` flag when the client doesn't
# specify it. true = enable Kimi-style query expansion before retrieval
# (~20s extra LLM round-trip; sharper retrieval on noisy questions).
# false = send the raw question to the embedder. Explicit per-request
# value still wins. The Tauri window UI doesn't expose a toggle today,
# so this env knob is the de-facto global setting for it.
REWRITE=false

# --- Qdrant ---
# Magpie targets exactly one Qdrant shape: the real Qdrant Rust binary
# running on localhost. Run it with:
#   just qdrant-install   # one-time download (~30 MB)
#   just qdrant-up        # start the binary
# Default port is 6433 (deliberately NOT Qdrant's 6333 — that conflicts
# with OpenWhispr and other apps that ship their own Qdrant). Override
# the port via QDRANT_CLUSTER_ENDPOINT below.
#
# Remote Qdrant Cloud / shared clusters are NOT supported — Magpie is
# local-first by design and the index never leaves your machine. The
# embedded Python shim was also dropped in 2026-05 because it silently
# disabled quantization, payload indexes, and other server features.
QDRANT_CLUSTER_ENDPOINT=http://localhost:6433

HF-TOKEN=your-hf-token-here
