# Which LLM provider to use. Valid: moonshot | openrouter | local
# (Provider-specific keys below; only the active provider's key needs to be set.)
LLM_PROVIDER=moonshot

# --- Moonshot Kimi (used when LLM_PROVIDER=moonshot) ---
MOONSHOT_API_KEY=sk-your-key-here
MOONSHOT_MODEL=kimi-k2.5
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# --- OpenRouter (used when LLM_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Local LLM via llama-server subprocess (LLM_PROVIDER=local) ---
# Subprocess-based local inference using llama.cpp's `llama-server`
# binary. The Python sidecar manages a pool of subprocesses (one per
# active model profile), spawning + health-checking + LRU-evicting as
# needed. See Specs/llama_server_migration.md.
#
# After `just sync-environment`, run `just install-llama-server` to
# download the right binary for this platform from llama.cpp's GitHub
# releases. macOS quarantine is stripped automatically.
#
# Model selection: `LOCAL_MODEL` is the HF GGUF *repo*; `LOCAL_QUANT`
# selects the specific file inside the repo. Defaults pull Unsloth's
# Dynamic-2.0 Q5_K_XL quant of Gemma 4 E4B (~6.7 GB, balanced
# quality/speed). Smaller options: Q4_K_XL (~5.1 GB, faster). Higher
# quality: Q6_K_XL (~7.5 GB), Q8_K_XL (~8.7 GB).
LOCAL_MODEL=unsloth/gemma-4-E4B-it-GGUF
LOCAL_QUANT=Q5_K_XL
# Context window in tokens. Bigger = more KV-cache RAM. 8192 fits Magpie's
# T3 / answer prompts comfortably; raise if your answer step needs longer
# document slices.
LOCAL_N_CTX=8192
# Sampling temperature. 0.0 = deterministic (good for structured-output
# T3 / rewrite). 0.7 = default for the answer step. /generate callers
# can override per-request.
LOCAL_TEMPERATURE=0.7

# --- llama-server pool / binary settings ---
# Path to the llama-server binary. Empty = auto-discover (env →
# <APP_DATA_DIR>/bin/llama-server → next to sys.argv[0]/bin → PATH).
LLAMA_SERVER_PATH=
# Minimum llama.cpp release tag we'll accept. Hard-fails at startup if
# the installed binary is older. Bump when adopting newer features.
LLAMA_SERVER_MIN_VERSION=b9049
# First port the pool tries when spawning a subprocess. NOT 8765 —
# that's the FastAPI sidecar. Pool walks forward (9100, 9101, ...)
# until it finds one not bound.
LLAMA_SERVER_BASE_PORT=9100
# How many subprocesses can be live concurrently. 1 = sequential
# (LRU eviction on each new profile). Bump on RAM-rich dev boxes
# where keeping text + vision both warm is worth ~3 GB extra.
LLAMA_SERVER_MAX_LOADED_MODELS=1
# Unload a subprocess after this many seconds of inactivity. Frees
# the model's RAM without losing the binary discovery / port state.
# Set to 0 to disable.
LLAMA_SERVER_IDLE_TIMEOUT_S=600
# Health-check timeout when spawning. Larger models load slower;
# this should accommodate the slowest profile + a margin.
LLAMA_SERVER_STARTUP_TIMEOUT_S=60
# Per-profile model selection. Profile names live in src/inference/profiles.py.
LLAMA_SERVER_TEXT_MODEL=gemma-4-e4b-text
# Vision profile used when complete(images=...) is called. Image-bearing
# T3 summaries (raw images, scanned PDFs) and image-tagged answer-step
# calls (PR 3) route here automatically. Set to empty to disable vision
# locally — image bytes silently fall through to a text-only summary.
LLAMA_SERVER_VISION_MODEL=gemma-4-e4b-vision
# mmproj projector variant for the default Gemma 4 vision profile.
# BF16 is the highest-fidelity (~946 MB); F16 / Q8_0 / Q4_K_M trade
# accuracy for RAM. Must match a filename Unsloth ships at
# unsloth/gemma-4-E4B-it-GGUF.
LOCAL_MMPROJ_VARIANT=BF16

# --- Pipeline knobs ---
# Default for the /query endpoint's `rewrite` flag when the client doesn't
# specify it. true = enable Kimi-style query expansion before retrieval
# (~20s extra LLM round-trip; sharper retrieval on noisy questions).
# false = send the raw question to the embedder. Explicit per-request
# value still wins. The Tauri window UI doesn't expose a toggle today,
# so this env knob is the de-facto global setting for it.
REWRITE=false

# --- Qdrant ---
# Magpie talks to a Qdrant Rust binary running on localhost — no env
# config needed in the common case. Set up with:
#   just qdrant-install   # one-time download (~30 MB)
#   just qdrant-up        # start the binary on port 6433
# Port 6433 (NOT Qdrant's default 6333) avoids colliding with OpenWhispr
# and other apps that ship their own Qdrant. Remote clusters and the
# embedded Python shim are both unsupported by design — Magpie is
# local-first and the index never leaves your machine.

HF-TOKEN=your-hf-token-here
