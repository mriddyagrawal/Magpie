# Which LLM provider to use. Valid: moonshot | openrouter | local
# (Provider-specific keys below; only the active provider's key needs to be set.)
LLM_PROVIDER=moonshot

# --- Moonshot Kimi (used when LLM_PROVIDER=moonshot) ---
MOONSHOT_API_KEY=sk-your-key-here
MOONSHOT_MODEL=kimi-k2.5
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# --- OpenRouter (used when LLM_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Local MLX (used when LLM_PROVIDER=local — Apple Silicon only) ---
# Default: mlx-community/gemma-3n-E2B-it-4bit (~2GB, auto-downloads on first use).
# Override to e.g. mlx-community/gemma-3n-E4B-it-4bit for higher quality on
# 16GB+ machines.
LOCAL_MODEL=mlx-community/gemma-3n-E2B-it-4bit

# Qdrant Cloud
QDRANT_API_KEY=your-api-key-here
QDRANT_CLUSTER_ENDPOINT=your-cluster-endpoint-here
HF-TOKEN=your-hf-token-here
