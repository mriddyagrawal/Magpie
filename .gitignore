__pycache__/
*.pyc
.env
.DS_Store
CLAUDE.md
.claude/scheduled_tasks.lock
Test Content/
Test Content Deprecated/
Test Summaries/
test_label/
Test Summaries 2 Deprecated/
Test Content 2 Deprecated/
qdrant_data/
# Qdrant's per-collection working snapshot dir, created in cwd whenever the
# server runs. Re-populated transiently every `just backup` run.
snapshots/

# Magpie UI artifacts
frontend/node_modules/
frontend/dist/
frontend/.turbo/
frontend/src-tauri/target/
frontend/src-tauri/gen/
# setuptools metadata — regenerated by every `uv sync` / editable install.
# The runtime reads the venv's dist-info, never these. Tracking them meant
# every sync dirtied the tree and blocked rebases. Pattern, not exact names:
# the root package already renamed once (notanotherspotlight -> magpie) and
# an exact-name rule silently stopped matching.
*.egg-info/

# Compiled sidecar binaries — built locally via `just build-sidecar`, never committed
frontend/src-tauri/binaries/

# PyInstaller build artifacts
build/
dist/
*.spec

# Local debug / scratch artifacts (do not commit)
# - appzip/ holds Windows debug-build zips (~1 GB+ each)
# - errors/ holds ad-hoc screenshots / failure captures
# - conversation-export*.md are local chat-session exports
appzip/
errors/
conversation-export*.md

# Bundled OpenRouter API key — baked into release builds at build time
# so the Cloud toggle works for end users without any setup. NEVER commit
# the real key. The .example file is the format contract; the actual key
# lives only on whoever's machine builds the release. Plan: replace with
# Magpie Cloud backend (Plan #40) once beta validates the toggle UX.
src/config/bundled_key.txt
src/config/bundled_webhook.txt

# Evaluation CORPORA + reports. Removed 2026-08 before the repo went public:
# the ground-truth answers embedded 42 real email addresses and 30+ phone
# numbers (university directory staff, plus receipts and personal documents).
# Regenerate locally with the run-evaluation skill; do not re-commit.
#
# Subdirectories only — every corpus lives in one (college_data/,
# furman_directory/, course_information/, student_notes/). The harness
# scripts at the top level (run_eval.py, transcribe_index.py, metrics.py …)
# are ordinary code with no personal data in them, and CONTINUE.md's resume
# commands call them by path, so they stay trackable.
Evaluations/*/

# Eval question sets built from real personal documents. `Test Content/`
# (the source receipts/PDFs) was never committed, but the ground-truth
# ANSWERS in `Test Questions/` embed the same data: a personal email, a
# hotel booking number, two airline reference codes, an itinerary and a
# per-item cost breakdown. `test_label/` is ReceiptQA-derived and carries
# third-party addresses in its answers. Both were listed here while still
# tracked — ignoring never untracks — so they shipped to the public repo
# anyway. Regenerate against synthetic documents; do not re-commit.
Test Questions/

.venv.broken/

# Eval harness (eval_harness/PLAN.md §3, §9.3): raw run state holds indexed
# personal content, scratch app-data dirs, and multi-GB logs - ignored via
# subpaths, NOT the runs/ tree, because git cannot re-include children of an
# excluded directory (review #25: a whole-tree rule silently discarded the
# committed summaries §9.3 decided to keep). config/metrics/report live
# directly in runs/<id>/ and stay trackable. Listed BEFORE the first run
# ever executes, because ignoring never untracks (see Test Questions/
# above for how that went last time).
eval_harness/runs/*/raw/
eval_harness/runs/*/appdata/
eval_harness/runs/*/logs/
# Corpora never live in the repo (size + privacy); manifests and golden
# QA do. Local corpus-root pointers are per-machine and untracked.
eval_harness/datasets/*/corpus/
eval_harness/datasets/*/corpus_root.local.json
