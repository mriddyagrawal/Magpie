{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Capability set for Magpie's settings window",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ]
}
