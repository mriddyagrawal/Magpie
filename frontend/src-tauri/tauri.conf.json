{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magpie",
  "version": "0.1.0",
  "identifier": "com.magpie.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Magpie",
        "width": 960,
        "height": 720,
        "minWidth": 900,
        "minHeight": 180,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Semantic search over your local files"
  }
}
