# Copy this to `server/.env` and fill in the values. Never commit `.env` —
# it's gitignored. In production, set these via the hosting provider's
# secrets manager (e.g. `fly secrets set OPENROUTER_API_KEY=...`).

# Bind. Use 0.0.0.0 inside containers, 127.0.0.1 for local dev.
HOST=127.0.0.1
PORT=8000

# Comma-separated invite codes. Each beta tester gets a unique one.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(16))"
# Example with three testers:
#   INVITE_CODES=alice-N7yLxQ4mPkR,bob-Hw3vTjF8nKs,carol-Z9bDqV2xMnL
# Empty string = no auth (only safe for localhost).
INVITE_CODES=

# OpenRouter API key. Get one at https://openrouter.ai
# Required for the LLM endpoints to work.
OPENROUTER_API_KEY=

# Per-endpoint model overrides. Change at runtime by updating these env
# vars and restarting the server — no app update needed.
ANSWER_MODEL=moonshotai/kimi-k2:free
REWRITE_MODEL=moonshotai/kimi-k2:free
SUMMARIZE_MODEL=moonshotai/kimi-k2:free
